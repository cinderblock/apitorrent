{
  "name": "apitorrent-workspace",
  "private": true,
  "description": "Bun workspace for the plugin SDK and first-party plugins. The web UI (web/) keeps its own lockfile.",
  "workspaces": ["packages/*", "plugins/*"],
  "scripts": {
    "build:plugins": "bun run --filter './plugins/*' build",
    "build:first-party": "bun scripts/build-first-party.ts",
    "test:plugins": "bun test ./packages ./plugins",
    "test:scripts": "bun test ./scripts",
    "typecheck:plugins": "bun run --filter './packages/*' --filter './plugins/*' typecheck"
  }
}
